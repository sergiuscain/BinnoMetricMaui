<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BinnoMetricMaui.View.ProductionRecordsChartsPage"
             xmlns:viewmodel="clr-namespace:BinnoMetricMaui.ViewModel"
             xmlns:view="clr-namespace:BinnoMetricMaui.View" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             Title="ProductionRecordsChartsPage">
    <Grid>
        <lvc:CartesianChart Series="{Binding Series}" 
                    BackgroundColor="{StaticResource Two}"
                    XAxes="{Binding XAxes}" 
                    HeightRequest="400"
                    ZoomMode="X"/>
    </Grid>
</ContentPage>