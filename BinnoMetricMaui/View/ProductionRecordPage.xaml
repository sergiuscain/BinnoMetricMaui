<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:BinnoMetricMaui.ViewModel"
             xmlns:view="clr-namespace:BinnoMetricMaui.View" 
             x:Class="BinnoMetricMaui.View.ProductionRecordPage">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="10">
            <CollectionView 
            ItemsSource="{Binding ProductionRecords}"
            VerticalScrollBarVisibility="Always">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*">
                                <!-- Строка 0: Продукт, Серия, Кол-во, ID -->
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding SeriesNumber, StringFormat='Серия: {0}'}"/>
                                <Label Grid.Row="0" Grid.Column="2" Text="{Binding ActualQuantity, StringFormat='Кол-во: {0}'}"/>
                                <Label Grid.Row="0" Grid.Column="3" Text="Линия: - "/>
                                <Label Grid.Row="0" Grid.Column="4" Text="{Binding Id, StringFormat='ID: {0}'}" HorizontalOptions="End"/>

                                <!-- Строка 1: пустая -->
                                <BoxView Grid.Row="1" Grid.ColumnSpan="4" HeightRequest="4"/>

                                <!-- Строка 2: Сотрудники -->
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding SeniorOperatorName, StringFormat='Старший: {0}'}"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding OperatorDName, StringFormat='Оператор D: {0}'}"/>
                                <Label Grid.Row="2" Grid.Column="2" Text="{Binding OperatorNKName, StringFormat='Оператор НКЛ: {0}'}"/>
                                <Label Grid.Row="2" Grid.Column="3" Text="{Binding PackerName, StringFormat='Укладчик: {0}'}"/>

                                <!-- Строка 3: пустая -->
                                <BoxView Grid.Row="3" Grid.ColumnSpan="4" HeightRequest="4"/>

                                <!-- Строка 4: Комментарий (на всю ширину) -->
                                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4">
                                    <Label Text="{Binding Comments, StringFormat='Комментарий: {0}'}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Margin="0,5">
                <FlexLayout Wrap="Wrap" JustifyContent="Center" BindableLayout.ItemsSource="{Binding Pages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Number}" 
                            BackgroundColor="{Binding Color}"
                            Command="{Binding Path=BindingContext.GoToPageCommand, Source={RelativeSource AncestorType={x:Type view:ProductionRecordPage}}}"
                            CommandParameter="{Binding Number}"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>
            <Button Style="{StaticResource ClearMessageBoxButton}" Command="{Binding CLearLogMessageCommand}" HorizontalOptions="Center" Text="Очистить лог"/>
            <Label Text="{Binding LogMessage}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>