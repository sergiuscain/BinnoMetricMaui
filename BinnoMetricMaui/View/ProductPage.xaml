<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:BinnoMetricMaui.ViewModel"
             xmlns:view="clr-namespace:BinnoMetricMaui.View"
             x:Class="BinnoMetricMaui.View.ProductPage">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="10">
            <Border>
                <Grid ColumnDefinitions="*,*,*">
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding AddProductCommand}" Text="Добавить продукт" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateProductsListCommand}" Text="Обновить" />
                </Grid>
            </Border>
            <CollectionView 
                ItemsSource="{Binding Products}"
                VerticalScrollBarVisibility="Always">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border  Style="{StaticResource ShadowBorder}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Style="{StaticResource SubtitleLabel}"  Text="{Binding Name}" Grid.Column="0"/>
                                <Button Grid.Column="1"
                                    Style="{StaticResource DangerButton}"
                                    Text="Удалить"
                                    Command="{Binding Path=BindingContext.DeleteProductCommand, 
                                    Source={RelativeSource AncestorType={x:Type view:ProductPage}}}"
                                    CommandParameter="{Binding Id}"/>
                                <Label Style="{StaticResource InfoLabel}" Text="{Binding Id, StringFormat='ID: {0}'}" Grid.Column="2"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Style="{StaticResource ClearMessageBoxButton}" Command="{Binding CLearLogMessageCommand}" HorizontalOptions="Center" Text="Очистить лог"/>
            <Label Text="{Binding LogMessage}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>