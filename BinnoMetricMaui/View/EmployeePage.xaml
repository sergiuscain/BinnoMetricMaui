<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:BinnoMetricMaui.ViewModel"
             x:Class="BinnoMetricMaui.View.EmployeePage">
    <VerticalStackLayout Spacing="10" Padding="10">
        <Button 
            Text="Обновить список"
            Command="{Binding UpdateEmployeeListCommand}"
            HorizontalOptions="Center" />

        <CollectionView 
            ItemsSource="{Binding Employees}"
            HeightRequest="300">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="5" Spacing="2">
                        <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" TextColor="Gray"/>
                        <Label Text="{Binding IsActive, StringFormat='Активен: {0}'}" FontSize="12"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding Message}"/>
    </VerticalStackLayout>
</ContentPage>