<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BinnoMetricMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BinnoMetricMaui"
    xmlns:view="clr-namespace:BinnoMetricMaui.View"
    Title="BinnoMetricMaui">

    <TabBar>
        <Tab Title="Продукты">
            <ShellContent ContentTemplate="{DataTemplate view:ProductPage}" />
        </Tab>
        <Tab Title="Сотрудники">
            <ShellContent ContentTemplate="{DataTemplate view:EmployeePage}" />
        </Tab>
    </TabBar>

</Shell>
